// tests/hash_vectors_tests.nv — the published vectors, and every
// length at which the padding changes its mind.
//
// Run from the package directory:
//
//   novo test tests/hash_vectors_tests.nv
//
// The expected digests here are NOT hand-computed.  They are the ones
// FIPS 180-4, RFC 6234 and RFC 1321 print, checked against OpenSSL
// before they were written into this file — which is what makes them
// evidence about this implementation rather than about whoever typed
// them.  The boundary digests, which no standard publishes, come from
// the same oracle.


use std.test
use std.bytes

// A test input built from hex, so nothing here depends on how a `Str`
// literal escapes a byte.  `from_hex` cannot fail on a literal this
// file generated, and the fallback keeps the type `Bytes` rather than
// `?Bytes`.
fn hexb(h: Str) -> Bytes
    bytes.from_hex(h) ?? bytes.zeros(0)

// `n` bytes of the byte `v` — the shape RFC 2202 and RFC 4231 write
// their keys and data in.
fn rep(n: Int, v: Int) -> Bytes
    var b = bytes.zeros(n)
    for i in 0..n
        b = bytes.set_u8(b, i, v)
    b

use hashing

// The vectors the standard itself publishes, in the order it
// publishes them.
@test
fn test_sha256_published_vectors()
    // the empty message
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb(""))),
                       "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    // the three-byte "abc"
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("616263"))),
                       "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    // the 56-byte string — one byte too long for its own block
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("6162636462636465636465666465666765666768666768696768696a68696a6b696a6b6c6a6b6c6d6b6c6d6e6c6d6e6f6d6e6f706e6f7071"))),
                       "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    // the 112-byte string — two blocks
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("61626364656667686263646566676869636465666768696a6465666768696a6b65666768696a6b6c666768696a6b6c6d6768696a6b6c6d6e68696a6b6c6d6e6f696a6b6c6d6e6f706a6b6c6d6e6f70716b6c6d6e6f7071726c6d6e6f707172736d6e6f70717273746e6f707172737475"))),
                       "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")

// The vectors the standard itself publishes, in the order it
// publishes them.
@test
fn test_sha512_published_vectors()
    // the empty message
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb(""))),
                       "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    // the three-byte "abc"
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("616263"))),
                       "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    // the 56-byte string — one byte too long for its own block
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("6162636462636465636465666465666765666768666768696768696a68696a6b696a6b6c6a6b6c6d6b6c6d6e6c6d6e6f6d6e6f706e6f7071"))),
                       "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445")
    // the 112-byte string — two blocks
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("61626364656667686263646566676869636465666768696a6465666768696a6b65666768696a6b6c666768696a6b6c6d6768696a6b6c6d6e68696a6b6c6d6e6f696a6b6c6d6e6f706a6b6c6d6e6f70716b6c6d6e6f7071726c6d6e6f707172736d6e6f70717273746e6f707172737475"))),
                       "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")

// The vectors the standard itself publishes, in the order it
// publishes them.
@test
fn test_sha1_published_vectors()
    // the empty message
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb(""))),
                       "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    // the three-byte "abc"
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("616263"))),
                       "a9993e364706816aba3e25717850c26c9cd0d89d")
    // the 56-byte string — one byte too long for its own block
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("6162636462636465636465666465666765666768666768696768696a68696a6b696a6b6c6a6b6c6d6b6c6d6e6c6d6e6f6d6e6f706e6f7071"))),
                       "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    // the 112-byte string — two blocks
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("61626364656667686263646566676869636465666768696a6465666768696a6b65666768696a6b6c666768696a6b6c6d6768696a6b6c6d6e68696a6b6c6d6e6f696a6b6c6d6e6f706a6b6c6d6e6f70716b6c6d6e6f7071726c6d6e6f707172736d6e6f70717273746e6f707172737475"))),
                       "a49b2446a02c645bf419f995b67091253a04a259")

// The vectors the standard itself publishes, in the order it
// publishes them.
@test
fn test_md5_published_vectors()
    // the empty message
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb(""))),
                       "d41d8cd98f00b204e9800998ecf8427e")
    // the three-byte "abc"
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("616263"))),
                       "900150983cd24fb0d6963f7d28e17f72")
    // the 56-byte string — one byte too long for its own block
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("6162636462636465636465666465666765666768666768696768696a68696a6b696a6b6c6a6b6c6d6b6c6d6e6c6d6e6f6d6e6f706e6f7071"))),
                       "8215ef0796a20bcaaae116d3876c664a")
    // the 112-byte string — two blocks
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("61626364656667686263646566676869636465666768696a6465666768696a6b65666768696a6b6c666768696a6b6c6d6768696a6b6c6d6e68696a6b6c6d6e6f696a6b6c6d6e6f706a6b6c6d6e6f70716b6c6d6e6f7071726c6d6e6f707172736d6e6f70717273746e6f707172737475"))),
                       "03dd8807a93175fb062dfb55dc7d359c")

// Every length where the padding changes its mind: one short of
// the length field, exactly at it, one short of a block, exactly
// a block, and the same four a block and two blocks later.
//
// The input is `i mod 251` so a byte out of place changes the
// digest, which a run of one repeated byte would not.
@test
fn test_sha256_block_boundaries()
    // 0 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb(""))),
                       "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    // 1 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("00"))),
                       "6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d")
    // 55 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30313233343536"))),
                       "463eb28e72f82e0a96c0a4cc53690c571281131f672aa229e0d45ae59b598b59")
    // 56 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031323334353637"))),
                       "da2ae4d6b36748f2a318f23e7ab1dfdf45acdc9d049bd80e59de82a60895f562")
    // 63 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e"))),
                       "29af2686fd53374a36b0846694cc342177e428d1647515f078784d69cdb9e488")
    // 64 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"))),
                       "fdeab9acf3710362bd2658cdc9a29e8f9c757fcf9811603a8c447cd1d9151108")
    // 65 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40"))),
                       "4bfd2c8b6f1eec7a2afeb48b934ee4b2694182027e6d0fc075074f2fabb31781")
    // 119 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f70717273747576"))),
                       "da18797ed7c3a777f0847f429724a2d8cd5138e6ed2895c3fa1a6d39d18f7ec6")
    // 120 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f7071727374757677"))),
                       "f52b23db1fbb6ded89ef42a23ce0c8922c45f25c50b568a93bf1c075420bbb7c")
    // 127 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e"))),
                       "92ca0fa6651ee2f97b884b7246a562fa71250fedefe5ebf270d31c546bfea976")
    // 128 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f"))),
                       "471fb943aa23c511f6f72f8d1652d9c880cfa392ad80503120547703e56a2be5")
    // 129 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80"))),
                       "5099c6a56203f9687f7d33f4bfdf576d31dc91f6b695ecea38b2770c87631135")
    // 191 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb(""))),
                       "d280f473c251cb75c91880ea0eca2a2f1cda3152bef54a38c4a3aedad615c819")
    // 192 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb(""))),
                       "8b4a544837a1a0280fa8a7c82865c27a1064b3cc6281fda0753566b9bb104a87")
    // 255 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb(""))),
                       "857df204175f077a9986709897f00ee0bcc0449585248e4b42498337e9329999")
    // 256 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha256(hexb(""))),
                       "5bc31b283cef0072274e97d74916552954c935794536cab632641e5ea071379d")

// Every length where the padding changes its mind: one short of
// the length field, exactly at it, one short of a block, exactly
// a block, and the same four a block and two blocks later.
//
// The input is `i mod 251` so a byte out of place changes the
// digest, which a run of one repeated byte would not.
@test
fn test_sha512_block_boundaries()
    // 0 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb(""))),
                       "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    // 1 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("00"))),
                       "b8244d028981d693af7b456af8efa4cad63d282e19ff14942c246e50d9351d22704a802a71c3580b6370de4ceb293c324a8423342557d4e5c38438f0e36910ee")
    // 55 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30313233343536"))),
                       "6856647f269c2ee3d8128f0b25427659d880641ef343300dd3cd4679168f58d6527fda70b4ebc854e2065e172b7d58c1536992c0810599259ba84a2b40c65414")
    // 56 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031323334353637"))),
                       "8b12b2f6fe400a51d29656e2b8c42a1bbfe6fcf3e425da430db05d1a2dda14790dee20fa8b22d8762afffe4988a5c98a4430d22a17e41e23d90fa61ab75671a9")
    // 63 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e"))),
                       "9dc9c5598e55dc42955695320839788e353f1d7f6ba74df74c80a8a52f463c0697f57f68835d1418f4ce9b6530cd79bd0f4c6f7e13c93feb1218c0b65c2c0561")
    // 64 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"))),
                       "ee4320ebaf3fdb4f2c832b137200c08e235e0fa7bbd0eb1740c7063ba8a0d151da77e003398e1714a955d475b05e3e950b639503b452ec185de4229bc4873949")
    // 65 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40"))),
                       "02856cef735f9acec6b9e33f0fbc8f9804d2aa54187f382b8ae842e5d3696c07459aad2a5aed25ea5e117eb1c7ba35da6a7a8adce9e6afe3ad79e9fa42d5bba8")
    // 119 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f70717273747576"))),
                       "43e497279c2ce805903a33b54b746ea92d607f7c4807986c849823b81097a9099b5896ac7cc66df3a93edc8a91b6f3971d6c7f5688daf635737760bd080e27b3")
    // 120 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f7071727374757677"))),
                       "9636708964c5ff6600510319e07bf3fcfcb1f4058fec278efb677964ba1e140c1632505452f802e99bcf09da3d456dc3868d149a0788a730e49d239ce7415145")
    // 127 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e"))),
                       "eab89674feaa34e27aebeeff3c0a4d70070bb872d5e9f186cf1dbbdee517b6e35724d629ff025a5b07185e911ada7e3c8acf830aa0e4f71777bd2d44f504f7f0")
    // 128 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f"))),
                       "1dffd5e3adb71d45d2245939665521ae001a317a03720a45732ba1900ca3b8351fc5c9b4ca513eba6f80bc7b1d1fdad4abd13491cb824d61b08d8c0e1561b3f7")
    // 129 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80"))),
                       "1d9da57fbbdab09afb3506ab2d223d06109d65c1c8ad197f50138f714bc4c3f2fe5787922639c680acad1c651f955990425954ce2cba0c5cc83f2667d878eb0f")
    // 191 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb(""))),
                       "1f63ee615e9b809e3661c77b5029c78a92dc4be3cc4dfd8bbe78dc7b7d990bc717238004969a8b854cba04b4d9b30aa1a1964264c47f23d9bcdf45c74fffd918")
    // 192 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb(""))),
                       "0351f475c711d068be7b0395d65343b5e249feaa3c3f3b6b87100c50306ef0340f60ef36233f0e6287057ef7be8634bfc4d46b49e4a8f2cc4839f42f486a16fb")
    // 255 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb(""))),
                       "e9746a5516961da1fdc8e6c59350cd147b7d80c120cc7ed621399faeb2462c28f34217a13009a8e6a721f538356db9a9b64d9a5412e0fd07d24cac1315d95548")
    // 256 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha512(hexb(""))),
                       "7ff1cd1e9773a4b7ba1f40e642db0d879bd5f6cc151a7d3401a0bc7778b8270c108b530fb195f2383f4cec8cf05778e6af4db56811673371674cec1524488f83")

// Every length where the padding changes its mind: one short of
// the length field, exactly at it, one short of a block, exactly
// a block, and the same four a block and two blocks later.
//
// The input is `i mod 251` so a byte out of place changes the
// digest, which a run of one repeated byte would not.
@test
fn test_sha1_block_boundaries()
    // 0 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb(""))),
                       "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    // 1 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("00"))),
                       "5ba93c9db0cff93f52b521d7420e43f6eda2784f")
    // 55 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30313233343536"))),
                       "8ae2d46729cfe68ff927af5eec9c7d1b66d65ac2")
    // 56 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031323334353637"))),
                       "636e2ec698dac903498e648bd2f3af641d3c88cb")
    // 63 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e"))),
                       "6d942da0c4392b123528f2905c713a3ce28364bd")
    // 64 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"))),
                       "c6138d514ffa2135bfce0ed0b8fac65669917ec7")
    // 65 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40"))),
                       "69bd728ad6e13cd76ff19751fde427b00e395746")
    // 119 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f70717273747576"))),
                       "41c89d06001bab4ab78736b44efe7ce18ce6ae08")
    // 120 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f7071727374757677"))),
                       "d3dbd653bd8597b7475321b60a36891278e6a04a")
    // 127 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e"))),
                       "89d7312a903f65cd2b3e34a975e55dbea9033353")
    // 128 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f"))),
                       "e6434bc401f98603d7eda504790c98c67385d535")
    // 129 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80"))),
                       "3352e41cc30b40ae80108970492b21014049e625")
    // 191 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb(""))),
                       "453e806d74a27e554f2a3395ce7917919bf3bde6")
    // 192 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb(""))),
                       "995b6f0c8f9eda20f3e5a2bd89df908747900008")
    // 255 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb(""))),
                       "47defa228fbd72b6de16bf15fb5ddd0d95f00cab")
    // 256 bytes
    test.assert_eq_str(bytes.to_hex(hashing.sha1(hexb(""))),
                       "d761175408c7032430f9e22f87ce8417be700f73")

// Every length where the padding changes its mind: one short of
// the length field, exactly at it, one short of a block, exactly
// a block, and the same four a block and two blocks later.
//
// The input is `i mod 251` so a byte out of place changes the
// digest, which a run of one repeated byte would not.
@test
fn test_md5_block_boundaries()
    // 0 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb(""))),
                       "d41d8cd98f00b204e9800998ecf8427e")
    // 1 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("00"))),
                       "93b885adfe0da089cdf634904fd59f71")
    // 55 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30313233343536"))),
                       "6912ee65fff2d9f9ce2508cddf8bcda0")
    // 56 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031323334353637"))),
                       "51fdd1acda72405dfdfa03fcb85896d7")
    // 63 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e"))),
                       "48a6295221902e8e0938f773a7185e72")
    // 64 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"))),
                       "b2d3f56bc197fd985d5965079b5e7148")
    // 65 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40"))),
                       "8bd7053801c768420faf816fadba971c")
    // 119 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f70717273747576"))),
                       "1c772251899a7ff007400b888d6b2042")
    // 120 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f7071727374757677"))),
                       "b7ba1efc6022e9ed272f00b8831e26e6")
    // 127 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e"))),
                       "8402b21e7bc7906493bae0dac017f1f9")
    // 128 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f"))),
                       "37eff01866ba3f538421b30b7cbefcac")
    // 129 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80"))),
                       "46f986692847558fc38b0cece591c20f")
    // 191 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb(""))),
                       "4810b77b79c8a77c2f237265d565384e")
    // 192 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb(""))),
                       "48599090c2176432f4fa671af1ccb6c2")
    // 255 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb(""))),
                       "158fbd8552a4d0bfe0a8667be32f9892")
    // 256 bytes
    test.assert_eq_str(bytes.to_hex(hashing.md5(hexb(""))),
                       "f37caf20c55a8b74b224b3164409ad2d")
